{
  "info": {
    "_postman_id": "healthcare-backend-postman-collection",
    "name": "Healthcare Backend API",
    "description": "Complete Postman collection for testing the Healthcare Backend APIs: Authentication (JWT), Patient Management, Doctor Management, and Patient-Doctor Mapping.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens && jsonData.tokens.access) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Dr. Jane Foster\",\n    \"email\": \"jane.foster@healthcare.com\",\n    \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Register a new user with name, email, and password. Automatically stores JWT access token in collection variable."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens && jsonData.tokens.access) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.tokens.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"dr.sarah@healthcare.com\",\n    \"password\": \"DoctorPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Log in an existing user with email and password to receive JWT tokens."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token/refresh/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            },
            "description": "Generate a new access token using a valid refresh token."
          }
        }
      ]
    },
    {
      "name": "2. Patient Management",
      "item": [
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Arthur Dent\",\n    \"age\": 42,\n    \"gender\": \"Male\",\n    \"contact_number\": \"+1-555-4242\",\n    \"email\": \"arthur.dent@example.com\",\n    \"address\": \"42 Galactica Way, Cityville\",\n    \"medical_history\": \"Frequent stress-induced migraines, otherwise healthy.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/patients/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", ""]
            },
            "description": "Add a new patient record (Authenticated users only)."
          }
        },
        {
          "name": "Get All Patients for Authenticated User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", ""]
            },
            "description": "Retrieve all patients created by the authenticated user."
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "1", ""]
            },
            "description": "Get details of a specific patient by ID."
          }
        },
        {
          "name": "Update Patient Details (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Robert Chase Updated\",\n    \"age\": 35,\n    \"gender\": \"Male\",\n    \"contact_number\": \"+1-555-0201\",\n    \"email\": \"robert.chase.updated@example.com\",\n    \"address\": \"500 Hospital Blvd, Princeton, NJ\",\n    \"medical_history\": \"Acute pancreatitis resolved. Regular lipid panel monitoring.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/patients/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "1", ""]
            },
            "description": "Update patient details."
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "1", ""]
            },
            "description": "Delete a patient record."
          }
        }
      ]
    },
    {
      "name": "3. Doctor Management",
      "item": [
        {
          "name": "Create Doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Stephen Strange\",\n    \"specialization\": \"Neurosurgery\",\n    \"phone\": \"+1-555-7788\",\n    \"email\": \"strange@metropolitan.org\",\n    \"years_of_experience\": 14\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", ""]
            },
            "description": "Add a new doctor (Authenticated users only)."
          }
        },
        {
          "name": "Get All Doctors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", ""]
            },
            "description": "Retrieve all doctors."
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "1", ""]
            },
            "description": "Get details of a specific doctor."
          }
        },
        {
          "name": "Update Doctor Details (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Gregory House\",\n    \"specialization\": \"Diagnostic Medicine & Nephrology\",\n    \"phone\": \"+1-555-0101\",\n    \"email\": \"house@diagnostics.org\",\n    \"years_of_experience\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "1", ""]
            },
            "description": "Update doctor details."
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "1", ""]
            },
            "description": "Delete a doctor record."
          }
        }
      ]
    },
    {
      "name": "4. Patient-Doctor Mapping",
      "item": [
        {
          "name": "Assign Doctor to Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"patient\": 1,\n    \"doctor\": 3,\n    \"notes\": \"Endocrine consultation referral.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mappings/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", ""]
            },
            "description": "Assign a doctor to a patient."
          }
        },
        {
          "name": "Get All Mappings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mappings/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", ""]
            },
            "description": "Retrieve all patient-doctor mappings."
          }
        },
        {
          "name": "Get Doctors Assigned to Specific Patient",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mappings/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", "1", ""]
            },
            "description": "Get all doctors assigned to a specific patient."
          }
        },
        {
          "name": "Remove Doctor from Patient (Delete Mapping)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mappings/1/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mappings", "1", ""]
            },
            "description": "Remove a doctor from a patient by mapping ID."
          }
        }
      ]
    }
  ]
}
